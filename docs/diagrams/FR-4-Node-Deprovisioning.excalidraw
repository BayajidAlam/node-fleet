      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 12,
      "containerId": "safety",
      "originalText": "Step 1 — Safety Check\nSkip if node hosts: kube-system non-DaemonSet pods\nStatefulSet pods, single-replica Deployment pods"
    },
