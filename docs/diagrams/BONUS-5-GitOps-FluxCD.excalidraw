      "versionNonce": 105,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Benefits:\n• Config as code: all K8s manifests in Git → PR review, rollback = git revert + push\n• Scale-down safe: FluxCD reschedules evicted pods to remaining healthy nodes\n• Dashboard updates: push JSON to gitops/ → ConfigMap updates → Grafana auto-reloads\n• No config drift: FluxCD reconciles any manual kubectl changes back to Git state",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 12,
      "containerId": "benefit",
      "originalText": "Benefits:\n• Config as code: all K8s manifests in Git → PR review, rollback = git revert + push\n• Scale-down safe: FluxCD reschedules evicted pods to remaining healthy nodes\n• Dashboard updates: push JSON to gitops/ → ConfigMap updates → Grafana auto-reloads\n• No config drift: FluxCD reconciles any manual kubectl changes back to Git state"
    }
