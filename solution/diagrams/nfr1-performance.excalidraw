    {
      "id": "why_t",
      "type": "text",
      "x": 36,
      "y": 216,
      "width": 688,
      "height": 88,
      "angle": 0,
      "strokeColor": "#4ca5d8",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 45,
      "version": 1,
      "versionNonce": 45,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Why so fast:\n1. Async design — Lambda fires RunInstances(<3s) and exits. No blocking wait for node.\n2. Node Ready check on NEXT invocation — heavy work spread across 2 Lambda calls.\n3. K3s userdata pre-fetches token from Secrets Manager with retries (not at script build time).",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 12,
      "containerId": "why",
      "originalText": "Why so fast:\n1. Async design — Lambda fires RunInstances(<3s) and exits. No blocking wait for node.\n2. Node Ready check on NEXT invocation — heavy work spread across 2 Lambda calls.\n3. K3s userdata pre-fetches token from Secrets Manager with retries (not at script build time)."
    }
  ],
