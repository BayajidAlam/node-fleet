{
  "title": "Node-Fleet Cost Dashboard",
  "uid": "cost-tracking",
  "tags": [
    "cost",
    "aws",
    "node-fleet"
  ],
  "timezone": "browser",
  "schemaVersion": 36,
  "version": 0,
  "refresh": "5m",
  "panels": [
    {
      "id": 1,
      "title": "Real-Time Hourly Cost",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(aws_ec2_instance_cost_per_hour{cluster=\"node-fleet\",job=\"cost-exporter\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4
        }
      }
    },
    {
      "id": 2,
      "title": "Daily Cost Projection",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(aws_ec2_instance_cost_per_hour{cluster=\"node-fleet\",job=\"cost-exporter\"}) * 24",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2
        }
      }
    },
    {
      "id": 3,
      "title": "Monthly Cost Projection",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(aws_ec2_instance_cost_per_hour{cluster=\"node-fleet\",job=\"cost-exporter\"}) * 730",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": 0,
                "color": "green"
              },
              {
                "value": 50,
                "color": "yellow"
              },
              {
                "value": 100,
                "color": "red"
              }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Cost Savings vs Static Fleet (1×t3.medium + 5×t3.small on-demand)",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "aws_autoscaling_savings_percentage{cluster=\"node-fleet\",job=\"cost-exporter\"}",
          "refId": "A",
          "legendFormat": "Savings %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": 0,  "color": "red"},
              {"value": 20, "color": "yellow"},
              {"value": 40, "color": "green"},
              {"value": 54, "color": "blue"}
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Cost Trend (24h)",
      "type": "graph",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(aws_ec2_instance_cost_per_hour{cluster=\"node-fleet\",job=\"cost-exporter\"})",
          "legendFormat": "Current Cost/Hour",
          "refId": "A"
        },
        {
          "expr": "0.0464 + (5 * 0.0232)",
          "legendFormat": "Static Fleet Baseline (1×t3.medium + 5×t3.small on-demand = $0.1624/hr)",
          "refId": "B"
        },
        {
          "expr": "aws_spot_savings_hourly{cluster=\"node-fleet\"}",
          "legendFormat": "Spot Savings/Hour",
          "refId": "C"
        }
      ],
      "yaxes": [
        {
          "format": "currencyUSD",
          "label": "Cost/Hour"
        },
        {
          "format": "short"
        }
      ]
    },
    {
      "id": 6,
      "title": "Cost Breakdown by Instance Type",
      "type": "piechart",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (instance_type) (aws_ec2_instance_cost_per_hour{cluster=\"node-fleet\",job=\"cost-exporter\"})",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        }
      }
    },
    {
      "id": 7,
      "title": "Cost Breakdown: Spot vs On-Demand",
      "type": "piechart",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (lifecycle) (aws_ec2_instance_cost_per_hour{cluster=\"node-fleet\",job=\"cost-exporter\"})",
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "CloudWatch Billing (All AWS Services)",
      "type": "timeseries",
      "datasource": {"type": "cloudwatch", "uid": "P034F075C744B399F"},
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {"type": "cloudwatch", "uid": "P034F075C744B399F"},
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "us-east-1",
          "namespace": "AWS/Billing",
          "metricName": "EstimatedCharges",
          "dimensions": {
            "Currency": ["USD"]
          },
          "statistic": "Maximum",
          "period": "86400",
          "matchExact": true,
          "refId": "A",
          "legendFormat": "Total Estimated Charges"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "tooltip": {"mode": "single"}
      }
    },
    {
      "id": 9,
      "title": "Instance Count by Type",
      "type": "table",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "expr": "count by (instance_type, lifecycle) (aws_ec2_instance_cost_per_hour{cluster=\"node-fleet\",job=\"cost-exporter\"})",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": []
    }
  ]
}
