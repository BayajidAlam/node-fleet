{
  "title": "Autoscaler Performance",
  "uid": "autoscaler-performance",
  "tags": ["autoscaler", "lambda", "performance", "node-fleet"],
  "timezone": "browser",
  "schemaVersion": 16,
  "version": 0,
  "refresh": "1m",
  "panels": [
    {
      "id": 1,
      "title": "Lambda Execution Duration",
      "type": "timeseries",
      "datasource": "CloudWatch",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "namespace": "AWS/Lambda",
          "metricName": "Duration",
          "dimensions": {
            "FunctionName": "node-fleet-prod-autoscaler"
          },
          "statistics": ["Average", "p50", "p95", "p99"],
          "region": "ap-southeast-1",
          "refId": "A"
        }
      ],
      "yaxes": [
        {
          "format": "ms",
          "label": "Duration (ms)"
        },
        {
          "format": "short"
        }
      ],
      "xaxis": {
        "mode": "time"
      }
    },
    {
      "id": 2,
      "title": "Lambda Invocation Count",
      "type": "stat",
      "datasource": "CloudWatch",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "namespace": "AWS/Lambda",
          "metricName": "Invocations",
          "dimensions": {
            "FunctionName": "node-fleet-prod-autoscaler"
          },
          "statistics": ["Sum"],
          "region": "ap-southeast-1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": 0,
                "color": "green"
              },
              {
                "value": 100,
                "color": "yellow"
              },
              {
                "value": 500,
                "color": "red"
              }
            ]
          }
        }
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value"
      }
    },
    {
      "id": 3,
      "title": "Scaling Decisions",
      "type": "piechart",
      "datasource": "CloudWatch",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "namespace": "NodeFleet/Autoscaler",
          "metricName": "ScaleUpEvents",
          "dimensions": {},
          "statistics": ["Sum"],
          "region": "ap-southeast-1",
          "refId": "A",
          "alias": "Scale Up"
        },
        {
          "namespace": "NodeFleet/Autoscaler",
          "metricName": "ScaleDownEvents",
          "dimensions": {},
          "statistics": ["Sum"],
          "region": "ap-southeast-1",
          "refId": "B",
          "alias": "Scale Down"
        },
        {
          "namespace": "NodeFleet/Autoscaler",
          "metricName": "AutoscalerInvocations",
          "dimensions": {},
          "statistics": ["Sum"],
          "region": "ap-southeast-1",
          "refId": "C",
          "alias": "Total Invocations"
        }
      ],
      "options": {
        "legend": {
          "display": true,
          "placement": "bottom"
        },
        "pieType": "pie",
        "displayLabels": ["percent", "name"]
      }
    },
    {
      "id": 4,
      "title": "Node Join Latency",
      "type": "timeseries",
      "datasource": "CloudWatch",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "namespace": "NodeFleet/Autoscaler",
          "metricName": "NodeJoinLatency",
          "dimensions": {},
          "statistics": ["Average", "p50", "p95", "p99", "Maximum"],
          "region": "ap-southeast-1",
          "refId": "A"
        }
      ],
      "yaxes": [
        {
          "format": "ms",
          "label": "Time to Ready (ms)"
        },
        {
          "format": "short"
        }
      ],
      "xaxis": {
        "mode": "time"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      }
    },
    {
      "id": 5,
      "title": "Cost Savings Estimate",
      "type": "gauge",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "aws_autoscaling_savings_percentage{cluster=\"node-fleet\",job=\"cost-exporter\"}",
          "refId": "A",
          "legendFormat": "Savings vs Static Fleet (1×t3.medium + 5×t3.small on-demand)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": 0,
                "color": "red"
              },
              {
                "value": 20,
                "color": "yellow"
              },
              {
                "value": 40,
                "color": "green"
              },
              {
                "value": 60,
                "color": "blue"
              }
            ]
          }
        }
      },
      "options": {
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      }
    },
    {
      "id": 6,
      "title": "Lambda Errors",
      "type": "graph",
      "datasource": "CloudWatch",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "namespace": "AWS/Lambda",
          "metricName": "Errors",
          "dimensions": {
            "FunctionName": "node-fleet-prod-autoscaler"
          },
          "statistics": ["Sum"],
          "region": "ap-southeast-1",
          "refId": "A"
        },
        {
          "namespace": "NodeFleet/Autoscaler",
          "metricName": "ScalingFailures",
          "dimensions": {},
          "statistics": ["Sum"],
          "region": "ap-southeast-1",
          "refId": "B"
        }
      ],
      "yaxes": [
        {
          "format": "short",
          "label": "Error Count"
        },
        {
          "format": "short"
        }
      ]
    },
    {
      "id": 7,
      "title": "Current Node Count",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "count(kube_node_info)",
          "datasource": "Prometheus",
          "refId": "A",
          "legendFormat": "Actual Nodes"
        },
        {
          "expr": "count(kube_node_info{node!~\".*master.*\"})",
          "datasource": "Prometheus",
          "refId": "B",
          "legendFormat": "Worker Nodes"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        }
      }
    }
  ]
}
